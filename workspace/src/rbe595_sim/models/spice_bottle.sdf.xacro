<?xml version="1.0"?>
<!--
  Reusable spice bottle: a cylinder with a tag36h11 AprilTag on its cap.

  The model origin is the centre of the bottle's base, so spawning it at the table-top height
  places it on the table. Spawn it with ros_gz_sim `create -string <output of xacro>`; see
  spawn_spice_bottle() in launch/sim.launch.py.

  Arguments:
    name      model name (must be unique in the world)
    tag_id    tag36h11 ID shown on the cap (images live in tags/, see tools/fetch_tags.py)
    radius    bottle radius [m]
    height    bottle height [m]
    mass      bottle mass [kg]
    tag_size  edge length of the tag image including its white border [m];
              the cap has a triangular pour-spout cutout on one half, so the tag
              sits only on the other (uncut) half, offset from the cap centre
              rather than centred on it; the tag's near edge sits tag_gap above
              the cap's centreline and its far corners must stay inside the cap's
              radius, i.e. (tag_size / 2)^2 + (tag_size + tag_gap)^2 <= radius^2
-->

<sdf xmlns:xacro="http://ros.org/wiki/xacro" version="1.9">
  <xacro:arg name="name" default="spice_bottle" />
  <xacro:arg name="tag_id" default="0" />
  <xacro:arg name="radius" default="0.024165" />
  <xacro:arg name="height" default="0.0813" />
  <xacro:arg name="mass" default="0.15" /> <!-- sim.launch.py draws 0.15-0.30 per jar -->
  <xacro:arg name="tag_size" default="0.02" />

  <xacro:property name="r" value="$(arg radius)" />
  <xacro:property name="h" value="$(arg height)" />
  <xacro:property name="m" value="$(arg mass)" />
  <xacro:property name="tag_size" value="$(arg tag_size)" />
  <!-- gap between the cap's centreline and the tag's near edge, clear of the cutout -->
  <xacro:property name="tag_gap" value="0.001" />
  <xacro:property name="tag_offset_y" value="${tag_gap + tag_size / 2}" />
  <xacro:property name="tag_file"
    value="$(find rbe595_sim)/tags/tag36_11_${'%05d' % int('$(arg tag_id)')}.png" />

  <model name="$(arg name)">
    <link name="link">
      <inertial>
        <pose>0 0 ${h / 2} 0 0 0</pose>
        <mass>${m}</mass>
        <inertia>
          <ixx>${m * (3 * r * r + h * h) / 12}</ixx>
          <iyy>${m * (3 * r * r + h * h) / 12}</iyy>
          <izz>${m * r * r / 2}</izz>
        </inertia>
      </inertial>

      <collision name="body_collision">
        <pose>0 0 ${h / 2} 0 0 0</pose>
        <geometry><cylinder><radius>${r}</radius><length>${h}</length></cylinder></geometry>
        <surface>
          <friction>
            <ode><mu>1.0</mu><mu2>1.0</mu2></ode>
          </friction>
        </surface>
      </collision>

      <visual name="body_visual">
        <pose>0 0 ${h / 2} 0 0 0</pose>
        <geometry><cylinder><radius>${r}</radius><length>${h}</length></cylinder></geometry>
        <material>
          <ambient>0.75 0.2 0.15 1</ambient>
          <diffuse>0.75 0.2 0.15 1</diffuse>
        </material>
      </visual>

      <!-- Tag: a flat textured plane on the uncut half of the cap, just above it so it
           does not z-fight with it, and clear of the triangular pour-spout cutout on
           the other half -->
      <visual name="tag_visual">
        <pose>0 ${tag_offset_y} ${h + 0.0005} 0 0 0</pose>
        <geometry>
          <plane>
            <normal>0 0 1</normal>
            <size>${tag_size} ${tag_size}</size>
          </plane>
        </geometry>
        <material>
          <diffuse>1 1 1 1</diffuse>
          <pbr>
            <metal>
              <albedo_map>${tag_file}</albedo_map>
              <roughness>1.0</roughness>
              <metalness>0.0</metalness>
            </metal>
          </pbr>
        </material>
      </visual>
    </link>
  </model>
</sdf>
