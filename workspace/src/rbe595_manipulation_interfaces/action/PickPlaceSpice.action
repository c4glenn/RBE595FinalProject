# Goal
string spice_id          # cap tag ID of the jar to fetch: "3", "tag3" or "tag_3"
---
# Result
bool success
string message            # "ok", or "failed at step <name>: <reason>"
---
# Feedback
string step_name          # e.g. "2/8 grasp_top"
int32 step_index          # 1..8
int32 total_steps         # 8
